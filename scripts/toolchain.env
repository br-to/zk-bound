# Noir and Barretenberg must stay in lockstep. Do not let `bbup -nv` pick a
# newer nightly: a mismatched bb yields UltraHonk proofs that fail
# HonkVerifier.verify with SumcheckFailed even when `nargo execute` succeeds
# and the committed fixture still passes `forge test`.
NOIR_VERSION=1.0.0-beta.22
BB_VERSION=5.0.0-nightly.20260522
